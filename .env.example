# Only needed for the optional `podman compose` path. Copy to .env and edit.

# Podman API socket path inside the Podman machine/host. Get it with:
#   podman info --format "{{.Host.RemoteSocket.Path}}"
# Rootful Podman: /run/podman/podman.sock   Rootless: /run/user/1000/podman/podman.sock
# Docker users:   /var/run/docker.sock
ENGINE_SOCKET=/run/podman/podman.sock

# Image name/tag
NETSCOPE_IMAGE=localhost/netscope:1.0

# Host port for the dashboard
NETSCOPE_PORT=8080
